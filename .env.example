# Copy to .env and fill in. .env is gitignored; never commit real values.
# live = call configured agents; mock = use /mock/*.json for every agent.
CREAO_MODE=live

# One App ID + one API key (capi_...) PER agent, from each agent's page on agent.creao.ai.
# A role left empty falls back to mock data and shows as "mock" in the Agent Team tab.
CREAO_APP_ID_MAIL=
CREAO_KEY_MAIL=

CREAO_APP_ID_ANALYST=
CREAO_KEY_ANALYST=

CREAO_APP_ID_PLANNER=
CREAO_KEY_PLANNER=

CREAO_APP_ID_DIGEST=
CREAO_KEY_DIGEST=

# Optional cost guards / tuning (defaults shown).
# CREAO_MAX_RUNS_PER_HOUR=4
# CREAO_POLL_MS=3000
# CREAO_TIMEOUT_MS=180000
